---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.4), com o desvio aprovado pelo cliente em
 * 19/10/2026: texto à esquerda e o espaço do formulário à direita (o padrão põe o
 * formulário à esquerda). Registrado em docs/BRIEFING.md (Desvios do padrão).
 * Mobile: texto antes do formulário. O formulário é sempre o shortcode, nunca um <form> próprio.
 *
 * O card da direita fica vazio de propósito: nele entra só o shortcode, que o plugin de
 * atendimento do WordPress troca pelo formulário. Ele não define fonte, cor nem alinhamento
 * do conteúdo, para não interferir no layout do formulário que o plugin renderiza.
 */
import Icon from './Icon.astro'
import { quote, cta } from '../data/content'
import { site } from '../data/site'
---

<section id="cotacao" class="bg-neutral-gray-100 pt-8 pb-20">
  <div class="mx-auto max-w-page px-6 lg:px-10">
    <div class="quote-grid grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)] lg:items-center lg:gap-14">
      {/* Coluna de texto */}
      <div>
        <span class="inline-flex items-center gap-3 font-sans text-[12px] font-bold tracking-[0.2em] text-primary-dark uppercase">
          <span aria-hidden="true" class="h-[3px] w-10 bg-accent-orange"></span>
          {quote.eyebrow}
        </span>

        <h2 class="mt-4 font-display text-[2.25rem] leading-[1.05] font-extrabold tracking-[-0.015em] text-primary-dark sm:text-[2.75rem] lg:text-[3rem]">
          {quote.title}
        </h2>

        <p class="mt-4 max-w-[520px] font-sans text-[17px] leading-relaxed text-ink-soft">
          {quote.text}
        </p>

        <button
          type="button"
          data-cta="cotacao-whatsapp"
          class="btn-slave-whats mt-6 inline-flex w-full items-center justify-center gap-3 bg-primary-dark px-7 py-4 font-sans text-base font-bold text-neutral-light transition-colors duration-200 hover:bg-primary-dark-800 sm:w-auto"
        >
          <Icon name="whatsapp" class="size-6 shrink-0" />
          {cta.whatsapp}
        </button>

        <ul class="mt-6 flex flex-wrap gap-x-7 gap-y-3">
          {quote.trust.map((item) => (
            <li class="flex items-center gap-2.5 font-sans text-[15px] text-ink">
              <Icon name={item.icon} class="size-6 shrink-0 text-accent-orange" />
              {item.label}
            </li>
          ))}
        </ul>
      </div>

      {/* Espaço do formulário: card vazio onde o plugin renderiza o shortcode */}
      <div class="w-full">
        <div class="quote-slot min-h-[360px] w-full rounded-xl border border-primary-dark/[0.06] bg-neutral-light p-6 shadow-[0_24px_48px_-30px_rgba(0,33,71,0.45)] sm:p-8">
          <slot name="shortcode" />
        </div>

        {/* Nota de LGPD */}
        <p class="mt-3 font-sans text-[11px] leading-relaxed text-ink-soft/80">
          {quote.lgpd}
          {site.privacyUrl && (
            <>
              {' '}
              <a
                href={site.privacyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold text-primary-dark underline-offset-2 hover:underline"
              >
                Política de privacidade
              </a>
              .
            </>
          )}
        </p>
      </div>
    </div>
  </div>
</section>
