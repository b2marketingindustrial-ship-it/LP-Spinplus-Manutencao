---
/**
 * Galeria de aplicações — fase "prova" da biblioteca B2.
 *
 * VARIANTE LOCAL DA SPINPLUS (aprovada pelo cliente em 19/10/2026, docs/BRIEFING.md,
 * Desvios do padrão): cabeçalho alinhado à esquerda, foto no topo do card sem número
 * sobreposto, e o número em vermelho acima do título, com a seta vermelha no rodapé. O
 * card inteiro continua sendo o CTA, por isso o `<button>` envolve a foto e o texto.
 *
 * ATENÇÃO: `npm run compose` recopia este arquivo da biblioteca e desfaz a variante.
 * Para recompor a página, restaure este arquivo do git depois de rodar o compose.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { applications } from '@data/sections/aplicacoes'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section id="aplicacoes" tone={tone} rhythm={rhythm}>
  <div class="max-w-4xl">
    <span class="inline-flex items-center gap-2.5 font-sans text-[12px] font-bold tracking-[0.2em] text-primary-dark uppercase">
      <span class="h-[7px] w-[7px] bg-accent-orange"></span>
      {applications.eyebrow}
    </span>
    <h2 class="mt-3 font-display text-[2.25rem] leading-[1.05] font-extrabold tracking-[-0.01em] text-primary-dark sm:text-[2.75rem] lg:text-[2.875rem]">
      {applications.title}
    </h2>
    <p class="mt-3 font-sans text-base leading-relaxed text-ink-soft lg:text-[17px]">
      {applications.text}
    </p>
  </div>

  <ul class="mt-9 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {applications.items.map((app, i) => (
      <li>
        <button
          type="button"
          data-cta={`aplicacoes-${app.id}`}
          class="btn-slave-whats app-card group relative flex h-full w-full flex-col overflow-hidden rounded-xl border border-primary-dark/[0.06] bg-neutral-light text-left shadow-[0_20px_44px_-30px_rgba(0,33,71,0.45)] transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:shadow-[0_30px_56px_-28px_rgba(0,33,71,0.5)]"
        >
          <div class="relative aspect-[5/3] overflow-hidden bg-neutral-gray-100">
            <Image
              src={app.photo.src}
              alt={app.photo.alt}
              format="webp"
              width={640}
              loading="lazy"
              decoding="async"
              class="app-card__photo h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.05]"
            />
          </div>

          <div class="flex flex-1 flex-col px-5 pt-4 pb-5">
            <span
              aria-hidden="true"
              class="font-display text-[15px] font-extrabold text-accent-orange"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="mt-0.5 font-display text-lg leading-snug font-extrabold text-primary-dark">
              {app.label}
            </span>
            <span class="mt-1.5 flex flex-1 justify-between gap-4">
              <span class="font-sans text-[14px] leading-relaxed text-ink-soft">
                {app.description}
              </span>
              <Icon
                name="arrow-right"
                class="mb-1 size-5 shrink-0 self-end text-accent-orange transition-transform duration-300 group-hover:translate-x-1"
              />
            </span>
          </div>
        </button>
      </li>
    ))}
  </ul>
</Section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .app-card,
    .app-card * {
      transition: none !important;
    }

    .app-card:hover,
    .app-card:hover .app-card__photo {
      transform: none;
    }
  }
</style>
