---
/**
 * Linhas de produto — fase "oferta" da biblioteca B2.
 *
 * VARIANTE LOCAL DA SPINPLUS (aprovada pelo cliente em 19/10/2026, docs/BRIEFING.md,
 * Desvios do padrão): cabeçalho em duas colunas fechado por um fio vermelho, e cards
 * 2×2 horizontais com a foto sangrando na lateral esquerda. O contrato da seção é o
 * mesmo da biblioteca — dados, CTAs `linhas-{id}`, um card escuro, tone/rhythm.
 *
 * ATENÇÃO: `npm run compose` recopia este arquivo da biblioteca e desfaz a variante.
 * Para recompor a página, restaure este arquivo do git depois de rodar o compose.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import BrandCarousel from '@components/BrandCarousel.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { productLines } from '@data/sections/linhas'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const lines = productLines.items
---

<Section id="linhas" tone={tone} rhythm={rhythm}>
  {/* Cabeçalho: título à esquerda, texto de apoio à direita, fio vermelho fechando */}
  <div class="grid gap-5 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:items-end lg:gap-12">
    <div>
      <span class="inline-flex items-center gap-2.5 font-sans text-[12px] font-bold tracking-[0.2em] text-accent-orange uppercase">
        <span class="h-[7px] w-[7px] bg-accent-orange"></span>
        {productLines.eyebrow}
      </span>
      <h2 class="mt-4 font-display text-[2.25rem] leading-[1.05] font-extrabold tracking-[-0.01em] text-primary-dark sm:text-[2.75rem] lg:text-[2.875rem]">
        {productLines.title}
      </h2>
    </div>

    <div class="lg:pb-1">
      <p class="max-w-[440px] font-sans text-base leading-relaxed text-ink-soft lg:text-[17px]">
        {productLines.text}
      </p>
      <BrandCarousel />
    </div>
  </div>

  <span aria-hidden="true" class="mt-8 block h-px w-full bg-accent-orange/70"></span>

  {/* Cards 2×2: foto à esquerda em toda a altura, conteúdo à direita */}
  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    {lines.map((line, i) => (
      <article
        class:list={[
          'product-card group relative flex flex-col overflow-hidden rounded-xl border transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1 sm:flex-row',
          line.dark
            ? 'navy-premium border-white/10 shadow-[0_24px_48px_-26px_rgba(0,24,48,0.7)] hover:shadow-[0_32px_60px_-26px_rgba(0,24,48,0.8)]'
            : 'border-primary-dark/[0.06] bg-neutral-light shadow-[0_20px_44px_-30px_rgba(0,33,71,0.4)] hover:shadow-[0_30px_56px_-28px_rgba(0,33,71,0.45)]',
        ]}
      >
        {/* Foto: faixa no topo no mobile, lateral em toda a altura a partir de tablet */}
        <div class="relative h-56 shrink-0 overflow-hidden sm:h-auto sm:w-[44%]">
          <Image
            src={line.photo.src}
            alt={line.photo.alt}
            format="webp"
            width={640}
            loading="lazy"
            decoding="async"
            class="product-card__photo absolute inset-0 h-full w-full object-cover object-[center_30%] transition-transform duration-500 ease-out group-hover:scale-[1.04]"
          />
        </div>

        {/* Conteúdo */}
        <div class="flex flex-1 flex-col px-6 pt-6 pb-5 lg:px-7 lg:pt-7">
          <div class="flex items-center gap-3">
            <span class="font-display text-[17px] font-extrabold text-accent-orange">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span aria-hidden="true" class="h-px w-12 bg-accent-orange"></span>
            <span
              class:list={[
                'font-sans text-[11px] font-semibold tracking-[0.18em] uppercase',
                line.dark ? 'text-neutral-light/70' : 'text-ink-soft',
              ]}
            >
              {line.tag}
            </span>
          </div>

          <h3
            class:list={[
              'mt-3 font-display text-[1.5rem] leading-[1.15] font-extrabold tracking-[-0.01em] lg:text-[1.625rem]',
              line.dark ? 'text-neutral-light' : 'text-primary-dark',
            ]}
          >
            {line.title}
          </h3>

          <p
            class:list={[
              'mt-2 font-sans text-[15px] leading-relaxed',
              line.dark ? 'text-neutral-light/70' : 'text-ink-soft',
            ]}
          >
            {line.description}
          </p>

          <ul class="mt-5 mb-6 flex flex-col gap-2.5">
            {line.features.map((feature) => (
              <li
                class:list={[
                  'flex items-center gap-3 font-sans text-[15px]',
                  line.dark ? 'text-neutral-light/90' : 'text-ink',
                ]}
              >
                <span
                  class:list={[
                    'flex size-7 shrink-0 items-center justify-center rounded-full',
                    line.dark
                      ? 'bg-accent-orange/75 text-neutral-light'
                      : 'bg-accent-orange/15 text-accent-orange',
                  ]}
                >
                  <Icon name="check" class="size-3.5" />
                </span>
                {feature}
              </li>
            ))}
          </ul>

          <button
            type="button"
            data-cta={`linhas-${line.id}`}
            class:list={[
              'btn-slave-whats mt-auto flex items-center justify-between gap-3 border-t pt-4 font-sans text-[15px] font-bold transition-colors duration-200 hover:text-accent-orange',
              line.dark
                ? 'border-white/15 text-neutral-light'
                : 'border-primary-dark/10 text-primary-dark',
            ]}
          >
            <span>{cta.card}</span>
            <span
              class:list={[
                'flex size-10 shrink-0 items-center justify-center rounded-full transition-[background-color,color,transform] duration-300 group-hover:translate-x-0.5 group-hover:bg-accent-orange group-hover:text-neutral-light',
                line.dark
                  ? 'bg-white/15 text-neutral-light'
                  : 'bg-neutral-gray-100 text-primary-dark',
              ]}
            >
              <Icon name="arrow-right" class="size-4" />
            </span>
          </button>
        </div>
      </article>
    ))}
  </div>
</Section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-card__photo,
    .product-card span {
      transition: none !important;
    }
    .product-card:hover {
      transform: none;
    }
    .product-card:hover .product-card__photo {
      transform: none;
    }
  }
</style>
