---
/**
 * Diferenciais — fase "autoridade" da biblioteca B2.
 *
 * VARIANTE LOCAL DA SPINPLUS (aprovada pelo cliente em 19/10/2026, docs/BRIEFING.md,
 * Desvios do padrão): bloco navy com o texto à esquerda e a foto clara sangrando à
 * direita, com o técnico recortado à frente; um traço vermelho no lugar do eyebrow; e os
 * 5 diferenciais numa faixa branca com divisórias, em vez de cards sobrepostos. O contrato
 * da seção é o mesmo da biblioteca — dados, CTA `diferenciais-cta`, bloco navy da fase de
 * autoridade, tone/rhythm.
 *
 * ATENÇÃO: `npm run compose` recopia este arquivo da biblioteca e desfaz a variante.
 * Para recompor a página, restaure este arquivo do git depois de rodar o compose.
 */
import { Picture, Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import Button from '@components/Button.astro'
import type { SectionProps } from '@lib/layout'
import { RHYTHMS } from '@lib/rhythm.mjs'
import { cta } from '@data/content'
import { why } from '@data/sections/diferenciais'

type Props = SectionProps

const { tone, rhythm } = Astro.props

/* A seção vai de borda a borda com os próprios blocos: o navy sobe sobre o respiro de cima
   (e a faixa sob a curva da seção anterior, --lp-round) e a faixa branca desce sobre o de
   baixo. Assim as divisórias arredondadas caem entre cores diferentes e aparecem. */
const bleedTop = RHYTHMS[rhythm]?.top ?? 0
const bleedBottom = RHYTHMS[rhythm]?.bottom ?? 0
---

<Section id="diferenciais" tone={tone} rhythm={rhythm} container={false}>
  {/* Bloco navy: no mobile a foto vem antes do texto; no desktop ela sangra à direita */}
  <div
    class="navy-premium relative flex flex-col overflow-hidden"
    style={`margin-top: calc(-${bleedTop}px - var(--lp-round, 0px)); padding-top: var(--lp-round, 0px)`}
  >
    <div class="why-photo relative h-[320px] sm:h-[420px] lg:absolute lg:inset-y-0 lg:right-0 lg:h-auto lg:w-[52%]">
      <Picture
        src={why.scene.src}
        alt={why.scene.alt}
        widths={[640, 1024, 1600]}
        sizes="(min-width: 1024px) 52vw, 100vw"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover object-center"
        pictureAttributes={{ class: 'absolute inset-0 h-full w-full' }}
      />
      {/* Emenda suave com o navy: só no desktop, onde foto e texto ficam lado a lado */}
      <span
        aria-hidden="true"
        class="pointer-events-none absolute inset-y-0 left-0 hidden w-40 bg-gradient-to-r from-primary-dark to-transparent lg:block"
      ></span>
      <Image
        src={why.person.src}
        alt={why.person.alt}
        format="webp"
        width={720}
        loading="lazy"
        decoding="async"
        class="why-person absolute bottom-0 h-[96%] w-auto max-w-none"
      />
    </div>

    <div class="relative mx-auto w-full max-w-page px-6 py-12 lg:px-10 lg:py-16">
      <div class="lg:max-w-[46%]">
        <span aria-hidden="true" class="block h-1 w-12 bg-accent-orange"></span>
        <h2 class="mt-5 font-display text-[2.375rem] leading-[1.04] font-extrabold tracking-[-0.015em] text-neutral-light sm:text-5xl lg:text-[2.625rem] xl:text-[3rem]">
          {why.titleLines.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </h2>
        <p class="mt-5 max-w-[600px] font-sans text-lg leading-relaxed text-neutral-light/85">
          {why.text}
        </p>
        <Button
          cta="diferenciais-cta"
          variant="primary"
          class="mt-7 w-full shadow-[0_16px_32px_-14px_rgba(229,38,32,0.8)] sm:w-auto"
        >
          {cta.primary}
        </Button>
      </div>
    </div>
  </div>

  {/* Faixa branca com os 5 diferenciais, separados por divisórias; fecha a seção com a curva */}
  <div
    class="rounded-b-[var(--lp-round)] bg-neutral-light shadow-[0_22px_40px_-26px_rgba(0,33,71,0.35)]"
    style={`margin-bottom: -${bleedBottom}px`}
  >
    <ul
      class="why-strip mx-auto grid max-w-page gap-x-6 gap-y-6 px-6 py-7 sm:grid-cols-2 lg:grid-cols-5 lg:gap-x-0 lg:px-10"
      aria-label={why.eyebrow}
    >
      {why.reasons.map((reason) => (
        <li class="why-item flex items-start gap-3.5">
          <Icon name={reason.icon} class="mt-0.5 size-9 shrink-0 text-accent-orange" />
          <div class="min-w-0">
            <h3 class="font-display text-[15px] leading-snug font-extrabold text-primary-dark">
              {reason.title}
            </h3>
            <p class="mt-1 font-sans text-[13.5px] leading-relaxed text-ink-soft">
              {reason.description}
            </p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</Section>

<style>
  /* O técnico fica à direita no desktop e centrado no mobile, com a base no chão do bloco. */
  .why-person {
    right: 50%;
    transform: translateX(50%);
    filter: drop-shadow(0 18px 28px rgb(0 15 35 / 0.35));
  }

  @media (min-width: 1024px) {
    .why-person {
      right: 8%;
      transform: none;
    }

    /* Divisórias verticais entre os diferenciais, como no layout aprovado. */
    .why-item {
      padding-inline: 1.5rem;
    }

    .why-item:first-child {
      padding-left: 0;
    }

    .why-item:last-child {
      padding-right: 0;
    }

    .why-item + .why-item {
      border-left: 1px solid rgb(0 33 71 / 0.1);
    }
  }
</style>
