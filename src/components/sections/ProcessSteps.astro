---
/**
 * Como funciona — fase "apoio" da biblioteca B2.
 *
 * VARIANTE LOCAL DA SPINPLUS (aprovada pelo cliente em 19/10/2026, docs/BRIEFING.md,
 * Desvios do padrão): bloco navy de ponta a ponta com a sala de compressores ao fundo,
 * cabeçalho à esquerda e as etapas numa linha do tempo vertical à direita, ligadas por um
 * fio vermelho. O contrato da seção é o mesmo da biblioteca — dados, CTA `processo-cta`,
 * bloco navy da fase de apoio, tone/rhythm.
 *
 * ATENÇÃO: `npm run compose` recopia este arquivo da biblioteca e desfaz a variante.
 * Para recompor a página, restaure este arquivo do git depois de rodar o compose.
 */
import { Picture } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import Button from '@components/Button.astro'
import Eyebrow from '@components/Eyebrow.astro'
import type { SectionProps } from '@lib/layout'
import { RHYTHMS } from '@lib/rhythm.mjs'
import { cta } from '@data/content'
import { process } from '@data/sections/processo'
import cenario from '@assets/heroBg.png'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const steps = process.steps

/* O bloco navy ocupa a seção inteira: avança sobre os respiros que a composição deu a ela
   (valores do ritmo, não números fixos) e, em cima, também sobre a faixa que fica sob a
   curva da seção anterior (--lp-round, global.css). Assim as divisórias arredondadas caem
   entre o navy e as seções vizinhas, e não entre duas áreas brancas. */
const bleedTop = RHYTHMS[rhythm]?.top ?? 0
const bleedBottom = RHYTHMS[rhythm]?.bottom ?? 0
---

<Section id="processo" tone={tone} rhythm={rhythm} container={false}>
  <div
    class="process-band relative overflow-hidden rounded-b-[var(--lp-round)] border-b-[3px] border-accent-orange bg-primary-dark-900"
    style={`margin-top: calc(-${bleedTop}px - var(--lp-round, 0px)); margin-bottom: -${bleedBottom}px; padding-top: var(--lp-round, 0px)`}
  >
    {/* Sala de compressores ao fundo, escurecida pelos véus navy */}
    <div aria-hidden="true" class="absolute inset-0 lg:-left-[8%] lg:w-full">
      <Picture
        src={cenario}
        alt=""
        widths={[640, 1024, 1600]}
        sizes="100vw"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-center"
        pictureAttributes={{ class: 'block h-full w-full' }}
      />
    </div>
    <span aria-hidden="true" class="process-veil pointer-events-none absolute inset-0"></span>

    <div class="relative mx-auto max-w-page px-6 py-16 lg:px-10 lg:py-20">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,470px)_minmax(0,560px)] lg:items-center lg:justify-between lg:gap-10">
        {/* Cabeçalho e CTA */}
        <div>
          <Eyebrow tone="light">{process.eyebrow}</Eyebrow>
          <h2 class="mt-4 max-w-[560px] font-display text-[2.5rem] leading-[1.02] font-extrabold tracking-[-0.015em] text-neutral-light sm:text-5xl lg:text-[3.25rem]">
            {process.title}
          </h2>
          <p class="mt-5 max-w-[520px] font-sans text-lg leading-relaxed text-neutral-light/80">
            {process.text}
          </p>

          <Button
            cta="processo-cta"
            variant="primary"
            class="mt-8 w-full shadow-[0_16px_32px_-14px_rgba(229,38,32,0.8)] sm:w-auto"
          >
            {cta.primary}
          </Button>

          <span class="mt-5 flex items-center gap-3 font-sans text-[15px] text-neutral-light/75">
            <Icon name="hard-hat" class="size-7 shrink-0 text-accent-orange" />
            {process.microcopy}
          </span>
        </div>

        {/* Linha do tempo: círculo com ícone, número vermelho, título e descrição */}
        <ol class="process-timeline relative">
          {steps.map((step, i) => (
            <li class="process-step relative flex gap-5">
              <span class="relative z-[2] mt-4 flex size-12 shrink-0 items-center justify-center rounded-full border-2 border-white/25 bg-primary-dark-900 text-neutral-light">
                <Icon name={step.icon} class="size-5" />
              </span>

              <div class="process-step__body flex flex-1 gap-5 border-b border-white/12 py-4">
                <span
                  aria-hidden="true"
                  class="w-8 shrink-0 pt-2.5 font-display text-xl font-extrabold text-accent-orange"
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div class="min-w-0 pt-1">
                  <h3 class="font-display text-lg leading-snug font-extrabold text-neutral-light">
                    {step.title}
                  </h3>
                  <p class="mt-1 max-w-[340px] font-sans text-[14px] leading-relaxed text-neutral-light/70">
                    {step.description}
                  </p>
                  {step.when && (
                    <span class="mt-2 inline-flex w-fit items-center gap-1.5 rounded-full border border-white/15 bg-white/5 px-2.5 py-1 font-sans text-[10px] font-bold tracking-[0.16em] text-neutral-light/75 uppercase">
                      <Icon name="clock" class="size-3 shrink-0 text-accent-orange" />
                      {step.when}
                    </span>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</Section>

<style>
  /* No mobile o texto cai sobre a foto inteira: véu navy quase opaco. */
  .process-veil {
    background: linear-gradient(
      180deg,
      rgb(0 24 48 / 0.82) 0%,
      rgb(0 24 48 / 0.9) 55%,
      var(--color-primary-dark-900) 100%
    );
  }

  /* No desktop a foto aparece entre o texto e a linha do tempo, como no layout aprovado. */
  @media (min-width: 1024px) {
    .process-veil {
      background:
        linear-gradient(
          90deg,
          rgb(0 24 48 / 0.92) 0%,
          rgb(0 24 48 / 0.82) 26%,
          rgb(0 24 48 / 0.3) 40%,
          rgb(0 24 48 / 0.25) 47%,
          rgb(0 24 48 / 0.85) 54%,
          var(--color-primary-dark-900) 58%
        ),
        linear-gradient(180deg, rgb(0 33 71 / 0.35) 0%, transparent 40%);
    }
  }

  /* Fio vermelho de círculo a círculo: sai da base deste (mt-4 + 48px) até o topo do próximo. */
  /* A última etapa não tem fio, então ele termina no último círculo. */
  .process-step:not(:last-child)::before {
    content: '';
    position: absolute;
    top: calc(1rem + 48px);
    bottom: -1rem;
    left: 23px;
    width: 2px;
    background: var(--color-accent-orange);
    pointer-events: none;
  }

  .process-step:last-child .process-step__body {
    border-bottom: 0;
  }
</style>
