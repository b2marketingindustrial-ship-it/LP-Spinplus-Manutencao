---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.2). Grid desktop: texto (1fr) · coluna VAZIA (270px) · shortcode (300px).
 * A coluna 2 é a janela do banner; nunca coloque conteúdo nela. O banner segue o brief 4.1.3.
 * Abra a página com `?grid=1` para ver as colunas e a zona do assunto sobre a imagem.
 *
 * Desvio aprovado pelo cliente em 19/10/2026 (segunda versão): o banner ocupa o hero
 * inteiro e já traz o lado esquerdo esfumado em branco, onde fica o texto; os três pontos
 * são itens soltos com ícone em círculo, abaixo dos CTAs; e o shortcode do chat fica num
 * card de vidro fosco que encosta na margem da tela. Grid e coluna de 300px do shortcode
 * seguem os do padrão. Registrado em docs/BRIEFING.md (Desvios do padrão).
 */
import { Picture } from 'astro:assets'
import Icon from './Icon.astro'
import Button from './Button.astro'
import Eyebrow from './Eyebrow.astro'
import { hero, cta } from '../data/content'
---

<section class="relative overflow-hidden bg-[#fbfbfd] [container-type:inline-size]" data-hero>
  {/* z1 — banner: faixa no rodapé da seção no mobile; no desktop, ancorado ao fim da coluna de texto */}
  <div class="hero-photo absolute inset-x-0 bottom-0 z-[1] h-[290px] lg:inset-y-0 lg:h-auto">
    <Picture
      src={hero.banner.src}
      alt={hero.banner.alt}
      widths={[640, 1024, 1536, 1981]}
      sizes="(min-width: 1024px) 1600px, 100vw"
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full object-cover object-[62%_center] lg:object-left"
      pictureAttributes={{ class: 'block h-full w-full' }}
    />
    {/* Emenda com o fundo da seção, caso a borda do banner não seja exatamente a mesma cor */}
    <span
      aria-hidden="true"
      class="pointer-events-none absolute inset-y-0 left-0 hidden w-32 bg-gradient-to-r from-[#fbfbfd] to-transparent lg:block"
    ></span>
  </div>

  {/* z5 — conteúdo */}
  <div class="relative z-[5] mx-auto max-w-page px-6 pt-14 pb-[330px] lg:px-10 lg:py-24">
    <div class="hero-grid grid items-center gap-y-12 lg:min-h-[560px] lg:gap-x-6">
      {/* Coluna 1 — textos */}
      <div class="max-w-xl lg:max-w-none">
        <Eyebrow tone="dark">{hero.eyebrow}</Eyebrow>

        <h1 class="mt-2 font-display text-[2.75rem] leading-[1.1] font-extrabold text-primary-dark sm:text-[3rem] lg:text-[2.75rem] xl:text-[3.1rem]">
          {hero.title}
        </h1>

        <p class="mt-5 font-sans text-lg leading-relaxed text-ink-soft">{hero.text}</p>

        <div class="mt-7 flex flex-wrap items-center gap-4">
          <Button cta="hero-primary" variant="primary">
            {cta.primary}
          </Button>
          <Button cta="hero-secondary" variant="outline-dark" iconName="search" iconPosition="left">
            {cta.secondary}
          </Button>
        </div>

        {/* 3 pontos soltos: ícone em círculo e texto sempre em duas linhas */}
        <ul class="hero-points mt-10 flex flex-col gap-y-5 sm:flex-row sm:gap-y-0">
          {hero.points.map((point) => (
            <li class="hero-point flex items-center gap-4 sm:flex-col sm:items-start sm:gap-3">
              <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-accent-orange/12">
                <Icon name={point.icon} class="size-7 text-accent-orange" />
              </span>
              <span class="font-sans text-[15px] leading-snug font-medium text-primary-dark">
                <span class="block whitespace-nowrap">{point.line1}</span>
                <span class="block whitespace-nowrap">{point.line2}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>

      {/* Coluna 2 — VAZIA de propósito: janela do banner */}
      <div class="hidden lg:block" aria-hidden="true"></div>

      {/* Coluna 3 — shortcode do chat (300px), em card de vidro fosco que encosta na margem da tela */}
      <div class="hero-chat w-full lg:w-[300px]">
        <div class="min-h-[430px] w-full rounded-2xl border border-white/70 bg-white/75 p-6 shadow-[0_30px_60px_-30px_rgba(0,33,71,0.45)] backdrop-blur-md">
          <slot name="shortcode" />
        </div>
      </div>
    </div>
  </div>

  {/* Overlay de depuração: ?grid=1 */}
  <div data-hero-grid hidden class="pointer-events-none absolute inset-0 z-[9]">
    <div class="hero-photo absolute inset-0">
      <div class="absolute inset-y-0 left-[62%] w-[17%] border-x-2 border-dashed border-accent-orange bg-accent-orange/10">
        <span class="absolute bottom-3 left-1/2 -translate-x-1/2 font-mono text-[11px] font-bold whitespace-nowrap text-accent-orange">
          zona B · 62–79%
        </span>
      </div>
      <div class="absolute inset-x-0 top-[17.5%] border-t border-dashed border-primary-dark/50"></div>
      <div class="absolute inset-x-0 bottom-[17.5%] border-t border-dashed border-primary-dark/50"></div>
    </div>
    <div class="mx-auto h-full max-w-page px-6 lg:px-10">
      <div class="hero-grid grid h-full lg:gap-x-6">
        <div class="border-x border-dashed border-primary-dark/60">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-white">
            col 1 · texto
          </span>
        </div>
        <div class="hidden border-x border-dashed border-accent-orange lg:block">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-accent-orange">
            col 2 · 270px · vazia
          </span>
        </div>
        <div class="hidden border-x border-dashed border-primary-dark/60 lg:block">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-white">
            col 3 · 300px · shortcode
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Divisórias sutis entre os pontos (a partir de tablet) */
  @media (width >= 40rem) {
    .hero-point + .hero-point {
      margin-left: 1.75rem;
      padding-left: 1.75rem;
      border-left: 1px solid rgb(0 33 71 / 0.12);
    }
  }

  /* Metade da largura da página (1320px / 2): ancora as colunas e a foto no mesmo eixo. */
  .hero-photo,
  .hero-grid {
    --page-half: calc(var(--container-page) / 2);
    --page-edge: max(0px, calc(50% - var(--page-half)));
    /* Fim da coluna de texto: page-edge + min(100%, página) − 658px (padding 40 · 270 · 300 · 2 gaps de 24). */
    --col-end: calc(var(--page-edge) + min(100%, var(--container-page)) - 658px);
  }

  @media (min-width: 1024px) {
    /* Col 1 (1fr) | Col 2 janela do banner | Col 3 shortcode 300px */
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) 270px 300px;
    }

    /* O banner começa antes do fim do texto, porque o lado esquerdo dele é esfumado em branco. */
    /* Com 560px de grid + 2×96px de padding, o hero tem ao menos 752px: o banner (2,2:1) aparece com */
    /* pelo menos 1654px de largura, e o RS 75i (43% dela) começa ≥ 24px depois do texto. */
    .hero-photo {
      left: calc(var(--col-end) - 688px);
      right: 0;
    }

    /* O card do chat sai do container e encosta na margem da tela, ao lado do compressor. */
    /* cqw e não %: em translateX o % seria da largura do próprio card, não da seção. */
    .hero-chat {
      transform: translateX(max(0px, calc(50cqw - var(--container-page) / 2)));
    }
  }
</style>

<script>
  // Overlay de depuração do grid: abra a página com ?grid=1
  if (new URLSearchParams(location.search).get('grid') === '1') {
    document.querySelectorAll<HTMLElement>('[data-hero-grid]').forEach((el) => {
      el.hidden = false
    })
  }
</script>
