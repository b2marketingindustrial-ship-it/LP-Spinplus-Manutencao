---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.2). Grid desktop: texto (1fr) · coluna VAZIA (270px) · shortcode (300px).
 * A coluna 2 é a janela do banner; nunca coloque conteúdo nela. O banner segue o brief 4.1.3.
 * Abra a página com `?grid=1` para ver as colunas e a zona do assunto sobre a imagem.
 *
 * Desvio aprovado pelo cliente em 19/10/2026: o véu navy da esquerda virou uma cunha
 * clara com o risco vermelho na diagonal, o texto passou a navy sobre claro e os três
 * pontos desceram para um card branco abaixo dos CTAs. Grid, âncora da foto e coluna do
 * shortcode seguem os do padrão. Registrado em docs/BRIEFING.md (Desvios do padrão).
 */
import { Picture } from 'astro:assets'
import Icon from './Icon.astro'
import Button from './Button.astro'
import Eyebrow from './Eyebrow.astro'
import { hero, cta } from '../data/content'

const isDev = import.meta.env.DEV
---

<section class="relative overflow-hidden bg-neutral-gray-100" data-hero>
  {/* z1 — banner: rodapé da seção no mobile, ancorado à borda direita do container no desktop */}
  <div class="hero-photo absolute inset-x-0 bottom-0 z-[1] h-[290px] lg:inset-0 lg:h-auto">
    <Picture
      src={hero.banner.src}
      alt={hero.banner.alt}
      widths={[640, 1024, 1536, 1981]}
      sizes="(min-width: 1024px) 1700px, 100vw"
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full object-cover"
      pictureAttributes={{ class: 'block h-full w-full' }}
    />
  </div>

  {/* z2 — cunha clara sobre a foto; a de baixo, 10px maior, deixa o risco vermelho à mostra */}
  <div class="hero-wedge-red pointer-events-none absolute inset-x-0 top-0 bottom-[280px] z-[2] lg:inset-y-0 lg:right-auto lg:bottom-0"></div>
  <div class="hero-wedge pointer-events-none absolute inset-x-0 top-0 bottom-[290px] z-[2] lg:inset-y-0 lg:right-auto lg:bottom-0"></div>

  {/* z5 — conteúdo */}
  <div class="relative z-[5] mx-auto max-w-page px-6 pt-14 pb-[330px] lg:px-10 lg:py-24">
    <div class="hero-grid grid items-center gap-y-12 lg:gap-x-6">
      {/* Coluna 1 — textos */}
      <div class="max-w-xl lg:max-w-none">
        <Eyebrow tone="dark">{hero.eyebrow}</Eyebrow>

        <h1 class="mt-2 font-display text-[2.75rem] leading-[1.1] font-extrabold text-primary-dark sm:text-[3rem] lg:text-[2.75rem] xl:text-[3.1rem]">
          {hero.title}
        </h1>

        <p class="mt-5 font-sans text-lg leading-relaxed text-ink-soft lg:text-base">{hero.text}</p>

        <div class="mt-7 flex flex-wrap items-center gap-4">
          <Button cta="hero-primary" variant="primary">
            {cta.primary}
          </Button>
          <Button cta="hero-secondary" variant="outline-dark" iconName="search" iconPosition="left">
            {cta.secondary}
          </Button>
        </div>

        {/* Card de 3 pontos — texto sempre em duas linhas */}
        <ul class="hero-points relative z-[3] mt-8 flex max-w-full flex-col gap-y-4 lg:max-w-none rounded-2xl border border-primary-dark/5 bg-neutral-light px-5 py-4 shadow-[0_24px_48px_-28px_rgba(0,33,71,0.4)] sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-6 lg:w-max lg:flex-nowrap">
          {hero.points.map((point) => (
            <li class="hero-point flex items-center gap-3">
              <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-accent-orange/10">
                <Icon name={point.icon} class="size-[20px] text-accent-orange" />
              </span>
              <span class="font-sans text-[13.5px] leading-snug font-semibold text-primary-dark">
                <span class="block whitespace-nowrap">{point.line1}</span>
                <span class="block whitespace-nowrap">{point.line2}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>

      {/* Coluna 2 — VAZIA de propósito: janela do banner */}
      <div class="hidden lg:block" aria-hidden="true"></div>

      {/* Coluna 3 — shortcode do chat (300px) */}
      <div class="w-full lg:w-[300px]">
        <slot name="shortcode">
          {isDev ? (
            <div
              class="flex min-h-[430px] w-full flex-col gap-3 rounded-xl border border-primary-dark/10 bg-neutral-light p-4 text-left shadow-[0_24px_48px_-28px_rgba(0,33,71,0.45)]"
              aria-label="Mock do chat (só em desenvolvimento)"
            >
              <span class="font-sans text-[11px] font-semibold tracking-[0.18em] text-accent-orange uppercase">
                Mock · chat
              </span>
              <p class="font-display text-base font-bold text-ink">Fale com um especialista</p>
              <div class="h-10 rounded border border-neutral-gray-200/70 bg-neutral-gray-100" />
              <div class="h-10 rounded border border-neutral-gray-200/70 bg-neutral-gray-100" />
              <div class="h-10 rounded border border-neutral-gray-200/70 bg-neutral-gray-100" />
              <div class="h-24 rounded border border-neutral-gray-200/70 bg-neutral-gray-100" />
              <div class="mt-auto h-11 rounded bg-accent-orange/80" />
            </div>
          ) : (
            <div class="flex min-h-[430px] w-full flex-col items-center justify-center gap-3 rounded-xl border border-dashed border-primary-dark/30 bg-neutral-light/85 p-6 text-center backdrop-blur-sm">
              <span class="font-sans text-[11px] font-semibold tracking-[0.18em] text-accent-orange uppercase">
                Espaço reservado
              </span>
              <p class="font-display text-lg font-bold text-primary-dark">Shortcode — 300px</p>
            </div>
          )}
        </slot>
      </div>
    </div>
  </div>

  {/* Overlay de depuração: ?grid=1 */}
  <div data-hero-grid hidden class="pointer-events-none absolute inset-0 z-[9]">
    <div class="hero-photo absolute inset-0">
      <div class="absolute inset-y-0 left-[62%] w-[17%] border-x-2 border-dashed border-accent-orange bg-accent-orange/10">
        <span class="absolute bottom-3 left-1/2 -translate-x-1/2 font-mono text-[11px] font-bold whitespace-nowrap text-accent-orange">
          zona B · 62–79%
        </span>
      </div>
      <div class="absolute inset-x-0 top-[17.5%] border-t border-dashed border-primary-dark/50"></div>
      <div class="absolute inset-x-0 bottom-[17.5%] border-t border-dashed border-primary-dark/50"></div>
    </div>
    <div class="mx-auto h-full max-w-page px-6 lg:px-10">
      <div class="hero-grid grid h-full lg:gap-x-6">
        <div class="border-x border-dashed border-primary-dark/60">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-white">
            col 1 · texto
          </span>
        </div>
        <div class="hidden border-x border-dashed border-accent-orange lg:block">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-accent-orange">
            col 2 · 270px · vazia
          </span>
        </div>
        <div class="hidden border-x border-dashed border-primary-dark/60 lg:block">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-white">
            col 3 · 300px · shortcode
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Divisórias sutis entre os destaques do hero (a partir de tablet) */
  @media (width >= 40rem) {
    .hero-point + .hero-point {
      padding-left: 1.5rem;
      border-left: 1px solid rgb(0 33 71 / 0.1);
    }
  }

  /* Metade da largura da página (1320px / 2): ancora as colunas e a foto no mesmo eixo. */
  .hero-photo,
  .hero-wedge,
  .hero-wedge-red,
  .hero-grid {
    --page-half: calc(var(--container-page) / 2);
    --page-edge: max(0px, calc(50% - var(--page-half)));
    /* Topo da diagonal, ancorado no fim da coluna de texto e não no meio da tela. */
    /* A coluna 1 termina em page-edge + min(100%, página) − 658px (padding 40 · 270 · 300 · 2 gaps de 24). */
    /* A diagonal fica 24px depois dela na base e 150px mais à direita no topo. */
    --wedge-top: calc(var(--page-edge) + min(100%, var(--container-page)) - 484px);
  }

  /* No mobile a cunha é um bloco claro sobre a faixa da foto; o risco fica horizontal. */
  .hero-wedge {
    background: linear-gradient(165deg, #ffffff 0%, var(--color-neutral-gray-100) 100%);
  }

  .hero-wedge-red {
    background: var(--color-accent-orange);
  }

  @media (min-width: 1024px) {
    /* Col 1 (1fr) | Col 2 janela do banner | Col 3 shortcode 300px */
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) 270px 300px;
    }

    /* A foto anda junto com a diagonal. Com 1430px o banner (1981×900) cabe inteiro na altura do hero, e o RS 75i começa a 563px da borda dele: o recuo de 638px o põe logo depois do risco, com o reservatório ainda na tela. O max() estica a foto em telas largas, onde 1430px não chegariam à borda direita. */
    .hero-photo {
      left: calc(var(--wedge-top) - 638px);
      right: auto;
      width: max(1430px, calc(100% - var(--wedge-top) + 638px));
    }

    /* A diagonal recua 150px da direita de cima para baixo; o par vermelho é 10px mais largo. */
    .hero-wedge,
    .hero-wedge-red {
      clip-path: polygon(0 0, 100% 0, calc(100% - 150px) 100%, 0 100%);
    }

    .hero-wedge {
      width: var(--wedge-top);
    }

    /* O vermelho existe só numa faixa ao longo da diagonal: se cobrisse a cunha inteira, */
    /* vazaria como um fio na borda do canto arredondado do hero (antialias do recorte). */
    .hero-wedge-red {
      width: calc(var(--wedge-top) + 8px);
      clip-path: polygon(
        calc(100% - 24px) 0,
        100% 0,
        calc(100% - 150px) 100%,
        calc(100% - 174px) 100%
      );
    }
  }
</style>

<script>
  // Overlay de depuração do grid: abra a página com ?grid=1
  if (new URLSearchParams(location.search).get('grid') === '1') {
    document.querySelectorAll<HTMLElement>('[data-hero-grid]').forEach((el) => {
      el.hidden = false
    })
  }
</script>
